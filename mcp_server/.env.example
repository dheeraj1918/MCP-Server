# ─────────────────────────────────────────────────────────────────────────────
# Factory OS — MCP Server environment template
# Copy to .env and fill in the values you need.
# Only the LLM keys are required; everything else is optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM PROVIDERS (at least one required) ────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── LLM MODEL SELECTION ───────────────────────────────────────────────────────
GROQ_MODEL=groq/llama3-8b-8192
GEMINI_MODEL=gemini/gemini-1.5-flash
OPENROUTER_FAST_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_GENERAL_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct
OPENROUTER_COMPLEX_MODEL=openrouter/anthropic/claude-3.5-sonnet

# ── GITHUB TOOL ───────────────────────────────────────────────────────────────
# Personal access token — needs: repo, workflow scopes
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── AWS S3 TOOL ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Comma-separated allowed bucket names (blank = allow all)
AWS_S3_ALLOWED_BUCKETS=

# ── VERCEL DEPLOY TOOL ────────────────────────────────────────────────────────
# Create token at: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── WEB SEARCH TOOL ───────────────────────────────────────────────────────────
# Provide a search API endpoint to enable web search
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=

# ── WORKSPACE & MEMORY ────────────────────────────────────────────────────────
FACTORY_OS_WORKSPACE=./workspace
FACTORY_OS_MEMORY_DB=./workspace/memory.db

# ── UNSAFE EXECUTION TOOLS ───────────────────────────────────────────────────
# WARNING: enables terminal_run and python_run — host-level code execution
FACTORY_OS_ENABLE_UNSAFE_TOOLS=false

# ── MCP TRANSPORT ─────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
