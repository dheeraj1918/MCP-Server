# LLM PROVIDERS
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# DEFAULT ROUTING
DEFAULT_FAST_PROVIDER=groq
DEFAULT_GENERAL_PROVIDER=gemini
DEFAULT_COMPLEX_PROVIDER=openrouter

# OpenRouter models
OPENROUTER_FAST_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_GENERAL_MODEL=xiaomi/mimo-v2.6-flash
OPENROUTER_COMPLEX_MODEL=xiaomi/mimo-v2.6-pro

# Gemini and Groq
GEMINI_MODEL=gemini/gemini-3.1-flash-lite
GROQ_MODEL=groq/openai/gpt-oss-20b

# MCP
MCP_TRANSPORT=stdio